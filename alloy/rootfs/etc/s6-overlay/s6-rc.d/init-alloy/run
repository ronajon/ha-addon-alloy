#!/usr/bin/with-contenv bash
set -e

CONFIG_DIR="/etc/alloy"
CONFIG_FILE="${CONFIG_DIR}/config.alloy"
OPTIONS_FILE="/data/options.json"
LABEL_NAME_RE='^[a-zA-Z_][a-zA-Z0-9_]*$'

mkdir -p "${CONFIG_DIR}" /data/alloy

# Read options
LOKI_URL=$(jq -r '.loki_url' "${OPTIONS_FILE}")
LOG_LEVEL=$(jq -r '.log_level // "info"' "${OPTIONS_FILE}")
ADDITIONAL_CONFIG=$(jq -r '.additional_config // ""' "${OPTIONS_FILE}")

# label_overrides is a JSON-object-shaped string option (same pattern as
# additional_config: a plain str? field the user fills with structured
# text), e.g. {"job": "home-assistant", "hostname": "host"}. Normalize
# unset/null to an empty object so downstream lookups always have valid
# JSON to work with, then fail loudly on genuinely malformed input rather
# than silently generating a broken pipeline.
LABEL_OVERRIDES_RAW=$(jq -r '.label_overrides // "{}"' "${OPTIONS_FILE}")
if [ -z "${LABEL_OVERRIDES_RAW}" ] || [ "${LABEL_OVERRIDES_RAW}" = "null" ]; then
    LABEL_OVERRIDES_RAW="{}"
fi
if ! echo "${LABEL_OVERRIDES_RAW}" | jq -e . >/dev/null 2>&1; then
    echo "ERROR: label_overrides is not valid JSON: ${LABEL_OVERRIDES_RAW}" >&2
    exit 1
fi

label_override() {
    # $1 = override key, $2 = default
    echo "${LABEL_OVERRIDES_RAW}" | jq -r --arg f "$1" --arg d "$2" '.[$f] // $d'
}

# job is a static label value (not derived from a journal field), so its
# override replaces the value itself.
JOB_LABEL=$(label_override job systemd-journal)
if [[ "${JOB_LABEL}" == *'"'* ]]; then
    echo "ERROR: label_overrides.job must not contain a double-quote character" >&2
    exit 1
fi

# The rest are all journal-field-derived via relabel rules, so their
# override renames the target_label instead of changing a value.
UNIT_TARGET=$(label_override unit unit)
HOSTNAME_TARGET=$(label_override hostname hostname)
SYSLOG_ID_TARGET=$(label_override syslog_identifier syslog_identifier)
TRANSPORT_TARGET=$(label_override transport transport)
CONTAINER_NAME_TARGET=$(label_override container_name container_name)
LEVEL_TARGET=$(label_override level level)

for pair in "unit:${UNIT_TARGET}" "hostname:${HOSTNAME_TARGET}" \
            "syslog_identifier:${SYSLOG_ID_TARGET}" "transport:${TRANSPORT_TARGET}" \
            "container_name:${CONTAINER_NAME_TARGET}" "level:${LEVEL_TARGET}"; do
    field="${pair%%:*}"
    target="${pair#*:}"
    if ! [[ "${target}" =~ ${LABEL_NAME_RE} ]]; then
        echo "ERROR: label_overrides.${field} = '${target}' is not a valid label name (must match ${LABEL_NAME_RE})" >&2
        exit 1
    fi
done

# Detect journal path
JOURNAL_PATH="/var/log/journal"
if [ ! -d "${JOURNAL_PATH}" ] || [ -z "$(ls -A "${JOURNAL_PATH}" 2>/dev/null)" ]; then
    JOURNAL_PATH="/run/log/journal"
fi

echo "-----------------------------------------------------------"
echo " Grafana Alloy for Home Assistant"
echo " Loki URL: ${LOKI_URL}"
echo " Journal path: ${JOURNAL_PATH}"
echo " Log level: ${LOG_LEVEL}"
if [ "${LABEL_OVERRIDES_RAW}" != "{}" ]; then
    echo " Label overrides: ${LABEL_OVERRIDES_RAW}"
fi
echo "-----------------------------------------------------------"

# Generate Alloy config
cat > "${CONFIG_FILE}" <<ALLOYCONFIG
// Grafana Alloy config - auto-generated by HAOS add-on
// Do not edit directly - configure via add-on options

logging {
  level = "${LOG_LEVEL}"
}

// --- Read systemd journal ---
loki.source.journal "journal" {
  path         = "${JOURNAL_PATH}"
  forward_to   = [loki.process.journal.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels       = {
    job = "${JOB_LABEL}",
  }
}

// --- Relabel journal fields ---
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "${UNIT_TARGET}"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "${HOSTNAME_TARGET}"
  }
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "${SYSLOG_ID_TARGET}"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label  = "${TRANSPORT_TARGET}"
  }
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "${CONTAINER_NAME_TARGET}"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "${LEVEL_TARGET}"
  }
}

// --- Process journal logs ---
loki.process "journal" {
  stage.drop {
    expression = "^\\\\s*$"
  }

  // dockerd logs every container's stdout at journal priority "info" and
  // stderr at "err" regardless of message content, so the priority-based
  // level is meaningless for container lines. Drop it and re-parse the level
  // from the line itself; lines without a recognisable token stay unlevelled
  // so Loki's own level detection can take over.
  stage.match {
    selector = "{${CONTAINER_NAME_TARGET}=~\\".+\\"}"

    stage.label_drop {
      values = ["${LEVEL_TARGET}"]
    }
  }

  stage.match {
    selector = "{${CONTAINER_NAME_TARGET}=~\\".+\\"} |~ \\"(?i)\\\\\\\\b(trace|debug|info|notice|warning|warn|error|err|critical|crit|fatal)\\\\\\\\b\\""

    stage.regex {
      expression = "(?i)\\\\b(?P<level_token>trace|debug|info|notice|warning|warn|error|err|critical|crit|fatal)\\\\b"
    }

    stage.template {
      source   = "level_token"
      template = "{{ if eq (ToLower .Value) \\"warn\\" }}warning{{ else if eq (ToLower .Value) \\"err\\" }}error{{ else if eq (ToLower .Value) \\"crit\\" }}critical{{ else }}{{ ToLower .Value }}{{ end }}"
    }

    stage.labels {
      values = { ${LEVEL_TARGET} = "level_token" }
    }
  }

  forward_to = [loki.write.loki.receiver]
}

// --- Write to Loki ---
loki.write "loki" {
  endpoint {
    url = "${LOKI_URL}"
  }
}
ALLOYCONFIG

# Append additional config if provided
if [ -n "${ADDITIONAL_CONFIG}" ] && [ "${ADDITIONAL_CONFIG}" != "null" ]; then
    echo "" >> "${CONFIG_FILE}"
    echo "// --- Additional user config ---" >> "${CONFIG_FILE}"
    echo "${ADDITIONAL_CONFIG}" >> "${CONFIG_FILE}"
fi

echo "Alloy config generated at ${CONFIG_FILE}"
